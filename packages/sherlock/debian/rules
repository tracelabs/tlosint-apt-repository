#!/usr/bin/make -f
#
# One venv per tool. sherlock, theHarvester, h8mail, instaloader and
# osrframework want mutually incompatible pins of requests/urllib3 --
# sharing one interpreter is precisely why the upstream script rots.

export DH_VIRTUALENV_INSTALL_ROOT=/opt/tracelabs
export DH_VIRTUALENV_ARGUMENTS=--python=/usr/bin/python3

%:
	dh $@ --with python-virtualenv

override_dh_virtualenv:
	dh_virtualenv \
	    --python /usr/bin/python3 \
	    --no-test \
	    --preinstall pip \
	    --preinstall setuptools \
	    --extra-pip-arg --require-hashes \
	    --requirements requirements.txt

override_dh_installsystemd:
	# no services

# TODO: wrapper in /usr/bin/sherlock -> /opt/tracelabs/sherlock/bin/sherlock

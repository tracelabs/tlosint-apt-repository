# Trace Labs OSINT templates for qvm-template, installed by qubes-repo-tlosint.
#
# $releasever is the dom0 Qubes release (e.g. 4.3), so this follows
# https://apt.tracelabs.org/qubes/r4.3 and moves with in-place upgrades.
#
#   qvm-template list --available debian-13-tlosint
#   qvm-template install debian-13-tlosint

[tlosint-templates]
name = Trace Labs OSINT templates
baseurl = https://apt.tracelabs.org/qubes/r$releasever
enabled = 1
metadata_expire = 7d
gpgcheck = 1
repo_gpgcheck = 0
gpgkey = file:///etc/qubes/repo-templates/keys/tlosint.asc
